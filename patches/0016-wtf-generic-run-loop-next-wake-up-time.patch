+std::optional<MonotonicTime> RunLoop::nextWakeUpTime()
+{
+    Locker locker { m_loopLock };
+    if (m_pendingTasks)
+        return MonotonicTime::now();
+    if (m_schedules.isEmpty())
+        return std::nullopt;
+    return m_schedules.first()->scheduledTimePoint();
+}
