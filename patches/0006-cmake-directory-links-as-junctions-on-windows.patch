+# Link a directory into the build tree. On Windows a junction: unlike a symlink it
+# needs neither Developer Mode nor elevation, and it resolves to the real path, so
+# headers reached through it keep one identity.
+function(WEBKIT_CREATE_DIRECTORY_LINK target link)
+    if (WIN32)
+        if (NOT EXISTS "${link}")
+            file(TO_NATIVE_PATH "${link}" _native_link)
+            file(TO_NATIVE_PATH "${target}" _native_target)
+            execute_process(COMMAND cmd /c mklink /J "${_native_link}" "${_native_target}"
+                RESULT_VARIABLE _result OUTPUT_QUIET ERROR_VARIABLE _error)
+            if (NOT _result EQUAL 0)
+                message(FATAL_ERROR "Could not create junction ${link}: ${_error}")
+            endif ()
+        endif ()
+    else ()
+        file(CREATE_LINK "${target}" "${link}" SYMBOLIC)
+    endif ()
+endfunction()
+
 function(WEBKIT_SYMLINK_FILES target_name)
