     m_caCertInfo = std::monostate { };
 }
 
+size_t CurlSSLHandle::addTrustedCertificates(std::span<const uint8_t> pem)
+{
+    auto* bio = BIO_new_mem_buf(pem.data(), static_cast<int>(pem.size()));
+    if (!bio)
+        return 0;
+    size_t added = 0;
+    Locker locker { m_trustedCertificatesLock };
+    while (auto* certificate = PEM_read_bio_X509(bio, nullptr, nullptr, nullptr)) {
+        m_trustedCertificates.append(certificate);
+        ++added;
+    }
+    // The end of the data reads as an error too.
+    ERR_clear_error();
+    BIO_free(bio);
+    return added;
+}
+
+void CurlSSLHandle::addTrustedCertificatesToStore(void* x509Store) const
+{
+    auto* store = static_cast<X509_STORE*>(x509Store);
+    Locker locker { m_trustedCertificatesLock };
+    for (auto* certificate : m_trustedCertificates)
+        X509_STORE_add_cert(store, static_cast<X509*>(certificate));
+    ERR_clear_error(); // already in the store
+}
+
