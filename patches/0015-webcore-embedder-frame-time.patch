     return protect(performance())->nowInReducedResolutionSeconds();
 }
 
-void LocalDOMWindow::freezeNowTimestamp()
+void LocalDOMWindow::freezeNowTimestamp(std::optional<MonotonicTime> frameTime)
 {
-    m_frozenNowTimestamp = nowTimestamp();
+    auto now = nowTimestamp();
+    // A frame time given by the embedder, never later than performance.now().
+    if (frameTime)
+        now = std::min(protect(performance())->relativeTimeFromTimeOriginInReducedResolutionSeconds(*frameTime), now);
+    m_frozenNowTimestamp = now;
 }
 
 void LocalDOMWindow::unfreezeNowTimestamp()
