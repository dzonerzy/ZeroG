diff --git a/cmake/Modules/merge_static_libs.cmake b/cmake/Modules/merge_static_libs.cmake
--- a/cmake/Modules/merge_static_libs.cmake
+++ b/cmake/Modules/merge_static_libs.cmake
@@ -93,7 +93,7 @@ function(merge_static_libs target in_target)
             COMMENT "Merge static libraries with libtool"
             COMMAND xcrun libtool -static -o $<TARGET_FILE:${target}> -no_warning_for_no_symbols ${libs}
         )
-    elseif(CMAKE_C_COMPILER_ID MATCHES "^(Clang|GNU|Intel|IntelLLVM)$")
+    elseif(CMAKE_C_COMPILER_ID MATCHES "^(Clang|GNU|Intel|IntelLLVM)$" AND NOT CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
         add_custom_command(
             TARGET ${target}
             POST_BUILD
@@ -116,6 +116,8 @@ function(merge_static_libs target in_target)
     elseif(MSVC)
         if(CMAKE_LIBTOOL)
             set(BUNDLE_TOOL ${CMAKE_LIBTOOL})
+        elseif(CMAKE_AR MATCHES "lib(\\.exe)?$")
+            set(BUNDLE_TOOL ${CMAKE_AR})
         else()
             find_program(BUNDLE_TOOL lib HINTS "${CMAKE_C_COMPILER}/..")

