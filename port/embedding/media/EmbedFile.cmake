# cmake -DINPUT=<file> -DOUTPUT=<file.c> -DSYMBOL=<name> -P EmbedFile.cmake
# Writes a C file defining `const unsigned char SYMBOL[]` with INPUT's bytes and
# `const unsigned long SYMBOL_size` (Web Audio's HRTF responses, compiled in).

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _length)
math(EXPR _size "${_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
# Lines of 32 bytes, so the file stays readable by compilers and editors.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
file(WRITE "${OUTPUT}" "/* Generated by EmbedFile.cmake from ${INPUT}. */\n"
    "const unsigned char ${SYMBOL}[] = {\n${_bytes}\n};\n"
    "const unsigned long ${SYMBOL}_size = ${_size};\n")
